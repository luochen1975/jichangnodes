 .hero-inner{text-align:center}\r\n .hero h1{margin:0 0 10px;font-size:36px}\r\n .subtitle{color:var(--muted)}\r\n .cta-row{margin-top:22px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap}\r\n .btn{display:inline-block;padding:12px 18px;border-radius:12px;border:1px solid var(--border);text-decoration:none;color:var(--text);box-shadow:0 6px 18px var(--shadow)}\r\n .btn.primary{background:linear-gradient(135deg,var(--brand),#4f7cff)} .btn.ghost{background:transparent} .btn.tiny{padding:8px 10px;font-size:12px}\r\n .section{padding:42px 0} .section.alt{background:linear-gradient(180deg,#0b0d14,#0a0b10)}\r\n .section-title{font-size:20px;margin:0 0 16px}\r\n .card-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}\r\n @media (max-width:960px){.card-grid{grid-template-columns:repeat(2,1fr)}}\r\n @media (max-width:640px){.card-grid{grid-template-columns:1fr}}\r\n .card{ display:block;background:var(--card);border:1px solid var(--border);border-radius:16px;padding:16px;text-decoration:none;color:var(--text); box-shadow:0 10px 24px var(--shadow);transition:transform .2s ease, border-color .2s ease }\r\n .card:hover{transform:translateY(-2px);border-color:#2b2f3a}\r\n .card-icon{font-size:22px;margin-bottom:8px}\r\n .card-title{font-weight:600}\r\n .card-desc{color:var(--muted);font-size:14px;margin-top:2px}\r\n .card-host{color:#b6c3ff;font-size:12px;margin-top:6px}\r\n .card-ping{font-size:12px;margin-top:6px;color:var(--good)}\r\n .card-ping.warn{color:var(--warn)} .card-ping.bad{color:var(--bad)} .card-ping.fail{color:var(--bad)}\r\n .tips{background:rgba(122,164,255,.08);border:1px dashed #2b3a5f;padding:12px;border-radius:12px;color:#c9d6ff}\r\n .ann-list{display:grid;gap:12px}\r\n .ann-card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:16px}\r\n .ann-title{font-weight:600}\r\n .ann-meta{color:var(--muted);font-size:12px;margin:4px 0 8px}\r\n .faq{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:12px;margin:10px 0}\r\n .site-footer{border-top:1px solid var(--border);padding:16px 0;background:rgba(13,15,21,.5);backdrop-filter:blur(10px)}\r\n .footer-inner{display:flex;align-items:center;justify-content:space-between;gap:12px}\r\n .footer-inner .muted{color:var(--muted);font-size:12px}\r\n .banner{background:rgba(255,209,102,.12);border:1px solid rgba(255,209,102,.4);color:#ffe8a3;border-radius:12px;padding:10px;margin:0 20px}\r\n </style>\r\n</head>\r\n<body>\r\n\r\n<!-- 密码保护开始（增强版） -->\r\n<div id="pw-mask" style="position:fixed;inset:0;background:#0b0c10;display:flex;align-items:center;justify-content:center;z-index:9999;">\r\n <div style="background:#121318;border:1px solid #1f2129;padding:24px;border-radius:14px;width:280px;text-align:center;box-shadow:0 10px 22px rgba(0,0,0,.45);">\r\n <h3 style="margin:0 0 12px;font-size:18px;color:#e8eaed;">访问验证</h3>\r\n <p style="margin:0 0 12px;color:#9aa0a6;font-size:14px;">请输入访问密码（提示：888）</p>\r\n <input id="pw-input" type="password" placeholder="输入密码"\r\n style="width:100%;padding:10px;border-radius:8px;border:1px solid #333;background:#0f1014;color:#fff;text-align:center;font-size:15px;">\r\n <button id="pw-btn" style="margin-top:14px;width:100%;padding:10px;border-radius:8px;background:#4f7cff;border:0;color:#fff;font-size:15px;cursor:pointer;">\r\n 确认\r\n </button>\r\n <p id="pw-msg" style="margin-top:10px;color:#ff7b7b;font-size:13px;display:none;">密码错误，请重新输入</p>\r\n <p id="pw-lock" style="margin-top:10px;color:#ffd166;font-size:13px;display:none;">密码输入错误次数过多，请 30 分钟后再尝试。</p>\r\n </div>\r\n</div>\r\n\r\n<script>\r\n(function(){\r\n const correct = "888";\r\n const secret = btoa(correct + "##");\r\n const PASS_KEY = "nav_access_pass";\r\n const ERROR_KEY = "nav_access_err";\r\n const LOCK_KEY = "nav_access_lock";\r\n\r\n const mask = document.getElementById("pw-mask");\r\n const input = document.getElementById("pw-input");\r\n const btn = document.getElementById("pw-btn");\r\n const msg = document.getElementById("pw-msg");\r\n const lockMsg = document.getElementById("pw-lock");\r\n\r\n const saved = localStorage.getItem(PASS_KEY);\r\n const lockUntil = parseInt(localStorage.getItem(LOCK_KEY) || "0", 10);\r\n\r\n if(Date.now() < lockUntil){\r\n lockMsg.style.display = "block";\r\n input.disabled = true;\r\n btn.disabled = true;\r\n return;\r\n }\r\n\r\n if(saved === secret){\r\n mask.style.display = "none";\r\n return;\r\n }\r\n\r\n function check(){\r\n const val = input.value.trim();\r\n let err = parseInt(localStorage.getItem(ERROR_KEY) || "0", 10);\r\n\r\n if(val === correct){\r\n localStorage.setItem(PASS_KEY, secret);\r\n localStorage.removeItem(ERROR_KEY);\r\n localStorage.removeItem(LOCK_KEY);\r\n mask.style.display = "none";\r\n return;\r\n }\r\n\r\n err++;\r\n localStorage.setItem(ERROR_KEY, err.toString());\r\n msg.style.display = "block";\r\n input.value = "";\r\n input.focus();\r\n\r\n if(err >= 3){\r\n const lockTime = Date.now() + 30 * 60 * 1000;\r\n localStorage.setItem(LOCK_KEY, lockTime.toString());\r\n input.disabled = true;\r\n btn.disabled = true;\r\n msg.style.display = "none";\r\n lockMsg.style.display = "block";\r\n }\r\n }\r\n\r\n btn.addEventListener("click", check);\r\n input.addEventListener("keydown", function(e){ if(e.key === "Enter") check(); });\r\n input.focus();\r\n})();\r\n</script>\r\n<!-- 密码保护结束 -->\r\n\r\n<header class="site-header" id="top">\r\n <div class="container header-inner">\r\n <div class="brand">\r\n <span class="logo" aria-hidden="true">◼︎</span>\r\n <span class="brand-name">oumei 导航</span>\r\n </div>\r\n <nav class="top-nav">\r\n <a href="#links">入口</a>\r\n <a href="#ann">公告</a>\r\n <a href="#help">帮助</a>\r\n </nav>\r\n </div>\r\n</header>\r\n\r\n<noscript>\r\n <div class="banner">您的浏览器已禁用 JavaScript，实时延迟与跳转可能不准确。请启用 JS 或更换浏览器。</div>\r\n</noscript>\r\n\r\n<main>\r\n <section class="hero">\r\n <div class="container hero-inner">\r\n <h1>一站式入口 & 备用通道</h1>\r\n <p class="subtitle">主域已切换至 <strong>oumei.lat</strong>，请更新收藏与订阅地址。</p>\r\n <div class="cta-row">\r\n <a class="btn primary" href="https://edge.oumei.lat" target="_blank" rel="noopener">进入面板（edge 入口）</a>\r\n <a class="btn ghost" href="#links">查看所有入口</a>\r\n </div>\r\n </div>\r\n </section>\r\n\r\n <section id="links" class="section">\r\n <div class="container">\r\n <h2 class="section-title">入口（实时延迟）</h2>\r\n\r\n <div class="card-grid">\r\n <!-- 你把这里改成你真实要用的入口域名 -->\r\n <a class="card" href="https://t6.oumei.lat" target="_blank" rel="noopener">\r\n <div class="card-icon">🚦</div>\r\n <div class="card-title">入口 t6</div>\r\n <div class="card-desc">就近接入 · 自动转发至源站</div>\r\n <div class="card-host">t6.oumei.lat</div>\r\n <div class="card-ping" id="ping-t6">延迟：检测中…</div>\r\n </a>\r\n\r\n <a class="card" href="https://t5.oumei.lat" target="_blank" rel="noopener">\r\n <div class="card-icon">🚦</div>\r\n <div class="card-title">入口 t5</div>\r\n <div class="card-desc">健康优选 · 与其他入口互为备份</div>\r\n <div class="card-host">t5.oumei.lat</div>\r\n <div class="card-ping" id="ping-t5">延迟：检测中…</div>\r\n </a>\r\n\r\n <a class="card" href="https://t3.oumei.lat" target="_blank" rel="noopener">\r\n <div class="card-icon">🚦</div>\r\n <div class="card-title">入口 t3</div>\r\n <div class="card-desc">高峰备份 · 多线路互补</div>\r\n <div class="card-host">t3.oumei.lat</div>\r\n <div class="card-ping" id="ping-t3">延迟：检测中…</div>\r\n </a>\r\n </div>\r\n\r\n <div class="tips" style="margin-top:14px">\r\n 小贴士：如果某个入口访问缓慢或失败，请切换其他入口；清理浏览器缓存或更换网络也有帮助。\r\n </div>\r\n </div>\r\n </section>\r\n\r\n <section id="ann" class="section alt">\r\n <div class="container">\r\n <h2 class="section-title">公告与更新</h2>\r\n <div class="ann-list" id="ann-list">\r\n <article class="ann-card">\r\n <div class="ann-title">[置顶] 域名更换公告</div>\r\n <div class="ann-meta">更新时间：<time id="ts">—</time></div>\r\n <div class="ann-body">\r\n 旧域 <strong>haoyifly.lat</strong> 已不可用，请统一使用 <strong>oumei.lat</strong> 相关入口与中转域名。\r\n </div>\r\n </article>\r\n </div>\r\n </div>\r\n </section>\r\n\r\n <section id="help" class="section">\r\n <div class="container">\r\n <h2 class="section-title">常见问题</h2>\r\n <details class="faq"><summary>如何注册登录？</summary><div>点击「进入面板（edge 入口）」后按提示注册登录。</div></details>\r\n <details class="faq"><summary>如何保持联系？</summary><div>浏览器打开这个网站加入纸飞机群（https://t.me/dasheng_guilai666）。</div></details>\r\n </div>\r\n </section>\r\n</main>\r\n\r\n<footer class="site-footer">\r\n <div class="container footer-inner">\r\n <div class="left">\r\n <div>© <span id="y"></span> oumei. All rights reserved.</div>\r\n <div class="muted">纸飞机群（https://t.me/dasheng_guilai666）</div>\r\n </div>\r\n <div class="right">\r\n <a href="#top" class="btn tiny" id="toTop">回到顶部 ↑</a>\r\n </div>\r\n </div>\r\n</footer>\r\n\r\n<script>\r\n(function(){\r\n const y=document.getElementById(\'y\'); if(y) y.textContent=new Date().getFullYear();\r\n const t=document.getElementById(\'ts\'); if(t) t.textContent=new Date().toISOString().slice(0,10);\r\n const toTop=document.getElementById(\'toTop\'); if(toTop) toTop.addEventListener(\'click\',e=>{e.preventDefault(); window.scrollTo({top:0,behavior:\'smooth\'});});\r\n})();\r\n\r\n// —— 延迟测试 ——\r\nconst HOSTS = [\r\n { host: \'t6.oumei.lat\', id: \'ping-t6\' },\r\n { host: \'t5.oumei.lat\', id: \'ping-t5\' },\r\n { host: \'t3.oumei.lat\', id: \'ping-t3\' },\r\n];\r\n\r\nfunction setPingText(id, ms) {\r\n const el = document.getElementById(id);\r\n if (!el) return;\r\n if (ms === null) { el.textContent = \'延迟：超时\'; el.className=\'card-ping fail\'; return; }\r\n el.textContent = `延迟：${ms} ms`;\r\n el.className=\'card-ping\' + (ms>400?\' bad\': ms>200?\' warn\':\'\');\r\n}\r\nfunction pingOnce(url, timeout=5000){\r\n const ctrl = new AbortController();\r\n const tid = setTimeout(()=>ctrl.abort(\'timeout\'), timeout);\r\n const start = performance.now();\r\n return fetch(url, { method: \'GET\', cache: \'no-store\', mode: \'no-cors\', signal: ctrl.signal })\r\n .then(()=> Math.round(performance.now()-start))\r\n .catch(()=> null)\r\n .finally(()=> clearTimeout(tid));\r\n}\r\nasync function testPing(host, id){\r\n const t = Date.now();\r\n const paths = [\'/cdn-cgi/trace\',\'/health\',\'/__ok.txt\'];\r\n for (const p of paths){\r\n const ms = await pingOnce(`https://${host}${p}?t=${t}`);\r\n if (ms !== null){ setPingText(id, ms); return; }\r\n }\r\n setPingText(id, null);\r\n}\r\nfunction loopPing(){ HOSTS.forEach(({host,id})=>testPing(host,id)); }\r\nloopPing(); setInterval(loopPing, 30000);\r\n</script>\r\n\r\n</body>\r\n</html>\r\n')

