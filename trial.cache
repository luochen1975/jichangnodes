ass="section">\n <div class="container">\n <h2 class="section-title">常见问题</h2>\n <details class="faq"><summary>如何注册登录？</summary><div>打开「进入面板（新域名）」后按提示注册登录。若在中国大陆遇到直连失败，请挂代理后使用上方“入口”。</div></details>\n <details class="faq"><summary>如何保持联系？</summary><div>打开魔法上网后浏览器打开这个网站加入纸飞机群（https://t.me/dasheng_guilai666）。</div></details>\n </div>\n </section>\n </main>\n\n <footer class="site-footer">\n <div class="container footer-inner">\n <div class="left">\n <div>© <span id="y"></span> haoyifly. All rights reserved.</div>\n <div class="muted">纸飞机群（https://t.me/dasheng_guilai666）</div>\n </div>\n <div class="right">\n <a href="#top" class="btn tiny" id="toTop">回到顶部 ↑</a>\n </div>\n </div>\n </footer>\n\n <script nonce="MjM0MzY2MTQ2NywxOTQ1ODEwMTA4">\n (function(){\n const y=document.getElementById(\'y\'); if(y) y.textContent=new Date().getFullYear();\n const t=document.getElementById(\'ts\'); if(t) t.textContent=new Date().toISOString().slice(0,10);\n const toTop=document.getElementById(\'toTop\'); if(toTop) toTop.addEventListener(\'click\',e=>{e.preventDefault(); window.scrollTo({top:0,behavior:\'smooth\'});});\n })();\n\n // —— 延迟测试 ——\n const HOSTS = [\n { host: \'t6.haoyifly.lat\', id: \'ping-t6\' },\n { host: \'t5.haoyifly.lat\', id: \'ping-t5\' },\n { host: \'t3.haoyifly.lat\', id: \'ping-t3\' },\n\n ];\n function setPingText(id, ms) {\n const el = document.getElementById(id);\n if (!el) return;\n if (ms === null) { el.textContent = \'延迟：超时\'; el.className=\'card-ping fail\'; return; }\n el.textContent = `延迟：${ms} ms`;\n el.className=\'card-ping\' + (ms>400?\' bad\': ms>200?\' warn\':\'\');\n }\n function pingOnce(url, timeout=5000){\n const ctrl = new AbortController();\n const tid = setTimeout(()=>ctrl.abort(\'timeout\'), timeout);\n const start = performance.now();\n return fetch(url, {\n method: \'GET\',\n cache: \'no-store\',\n mode: \'no-cors\',\n keepalive: false,\n signal: ctrl.signal,\n redirect: \'follow\'\n }).then(()=> Math.round(performance.now()-start))\n .catch(()=> null)\n .finally(()=> clearTimeout(tid));\n }\n async function testPing(host, id){\n const t = Date.now();\n const paths = [\'/__ok.txt\',\'/cdn-cgi/trace\',\'/health\'];\n for (const p of paths){\n const ms = await pingOnce(`https://${host}${p}?t=${t}`);\n if (ms !== null){ setPingText(id, ms); return; }\n }\n setPingText(id, null);\n }\n function loopPing(){ HOSTS.forEach(({host,id})=>testPing(host,id)); }\n loopPing(); setInterval(loopPing, 30000);\n </script>\n\n <script>\n (function(){\n var isFile = location.protocol === \'file:\';\n if(!isFile) return;\n try{\n [\'ping-t6\',\'ping-t2\',\'ping-t3\',\'ping-o1\',\'ping-o2\',\'ping-o3\'].forEach(function(id){\n var el=document.getElementById(id); if(el){ el.textContent=\'本地预览模式（未测速）\'; el.className=\'card-ping warn\'; }\n });\n var y=document.getElementById(\'y\'); if(y) y.textContent=new Date().getFullYear();\n var t=document.getElementById(\'ts\'); if(t) t.textContent=new Date().toISOString().slice(0,10);\n console.log(\'[preview] 以 file:// 打开，已切换为本地预览模式（不发起网络请求）\');\n }catch(e){console.warn(e)}\n })();\n </script>\n</body>\n</html>\n')

