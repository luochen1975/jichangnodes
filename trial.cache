st msg = document.getElementById("pw-msg");\n const lockMsg = document.getElementById("pw-lock");\n\n // ======== 检查是否已通过验证 ========\n const saved = localStorage.getItem(PASS_KEY);\n const lockUntil = parseInt(localStorage.getItem(LOCK_KEY) || "0", 10);\n\n // 如果被冻结\n if(Date.now() < lockUntil){\n lockMsg.style.display = "block";\n input.disabled = true;\n btn.disabled = true;\n return;\n }\n\n // 已通过验证，直接隐藏遮罩\n if(saved === secret){\n mask.style.display = "none";\n return;\n }\n\n // ======== 密码检查函数 ========\n function check(){\n const val = input.value.trim();\n\n // 特殊：输错三次 -> 冻结 30 分钟\n let err = parseInt(localStorage.getItem(ERROR_KEY) || "0", 10);\n\n if(val === correct){\n // 写入通过标记（记住 24 小时）\n localStorage.setItem(PASS_KEY, secret);\n localStorage.removeItem(ERROR_KEY);\n localStorage.removeItem(LOCK_KEY);\n mask.style.display = "none";\n return;\n }\n\n // 输入错误\n err++;\n localStorage.setItem(ERROR_KEY, err.toString());\n msg.style.display = "block";\n input.value = "";\n input.focus();\n\n if(err >= 3){\n const lockTime = Date.now() + 30 * 60 * 1000; // 30 分钟\n localStorage.setItem(LOCK_KEY, lockTime.toString());\n input.disabled = true;\n btn.disabled = true;\n msg.style.display = "none";\n lockMsg.style.display = "block";\n }\n }\n\n // 点击确认\n btn.addEventListener("click", check);\n\n // 回车键确认\n input.addEventListener("keydown", function(e){\n if(e.key === "Enter") check();\n });\n\n input.focus();\n\n})();\n</script>\n<!-- 密码保护结束（增强版） -->\n <header class="site-header">\n <div class="container header-inner">\n <div class="brand">\n <span class="logo" aria-hidden="true">◼︎</span>\n <span class="brand-name">haoyifly 导航</span>\n </div>\n <nav class="top-nav">\n <a href="#links">入口</a>\n <a href="#ann">公告</a>\n <a href="#help">帮助</a>\n </nav>\n </div>\n </header>\n\n <noscript>\n <div class="banner">您的浏览器已禁用 JavaScript，实时延迟与跳转可能不准确。请启用 JS 或更换浏览器。</div>\n </noscript>\n\n <main>\n <section class="hero">\n <div class="container hero-inner">\n <h1>一站式入口 & 备用通道</