center}\n .hero h1{margin:0 0 10px;font-size:36px}\n .subtitle{color:var(--muted)}\n .cta-row{margin-top:22px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap}\n .btn{display:inline-block;padding:12px 18px;border-radius:12px;border:1px solid var(--border);text-decoration:none;color:var(--text);box-shadow:0 6px 18px var(--shadow)}\n .btn.primary{background:linear-gradient(135deg,var(--brand),#4f7cff)} .btn.ghost{background:transparent} .btn.tiny{padding:8px 10px;font-size:12px}\n .section{padding:42px 0} .section.alt{background:linear-gradient(180deg,#0b0d14,#0a0b10)}\n .section-title{font-size:20px;margin:0 0 16px} .section-title.mt{margin-top:20px}\n .card-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}\n @media (max-width:960px){.card-grid{grid-template-columns:repeat(2,1fr)}}\n @media (max-width:640px){.card-grid{grid-template-columns:1fr}}\n .card{ display:block;background:var(--card);border:1px solid var(--border);border-radius:16px;padding:16px;text-decoration:none;color:var(--text); box-shadow:0 10px 24px var(--shadow);transition:transform .2s ease, border-color .2s ease }\n .card:hover{transform:translateY(-2px);border-color:#2b2f3a}\n .card-icon{font-size:22px;margin-bottom:8px}\n .card-title{font-weight:600}\n .card-desc{color:var(--muted);font-size:14px;margin-top:2px}\n .card-host{color:#b6c3ff;font-size:12px;margin-top:6px}\n .card-ping{font-size:12px;margin-top:6px;color:var(--good)}\n .card-ping.warn{color:var(--warn)} .card-ping.bad{color:var(--bad)} .card-ping.fail{color:var(--bad)}\n .tips{background:rgba(122,164,255,.08);border:1px dashed #2b3a5f;padding:12px;border-radius:12px;color:#c9d6ff}\n .ann-list{display:grid;gap:12px}\n .ann-card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:16px}\n .ann-title{font-weight:600}\n .ann-meta{color:var(--muted);font-size:12px;margin:4px 0 8px}\n .faq{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:12px;margin:10px 0}\n .site-footer{border-top:1px solid var(--border);padding:16px 0;background:rgba(13,15,21,.5);backdrop-filter:blur(10px)}\n .footer-inner{display:flex;align-items:center;justify-content:space-between;gap:12px}\n .footer-inner .muted{color:var(--muted);font-size:12px}\n .banner{background:rgba(255,209,102,.12);border:1px solid rgba(255,209,102,.4);color:#ffe8a3;border-radius:12px;padding:10px;margin:0 20px}\n </style>\n</head>\n<body>\n <!-- 密码保护开始（增强版） -->\n<div id="pw-mask" style="\n position:fixed;inset:0;\n background:#0b0c10; \n display:flex;align-items:center;justify-content:center;\n z-index:9999;">\n <div style="background:#121318;border:1px solid #1f2129;\n padding:24px;border-radius:14px;width:280px;text-align:center;\n box-shadow:0 10px 22px rgba(0,0,0,.45);">\n <h3 style="margin:0 0 12px;font-size:18px;color:#e8eaed;">访问验证</h3>\n <p style="margin:0 0 12px;color:#9aa0a6;font-size:14px;">请输入访问密码（提示：888）</p>\n <input id="pw-input" type="password" placeholder="输入密码"\n style="width:100%;padding:10px;border-radius:8px;border:1px solid #333;\n background:#0f1014;color:#fff;text-align:center;font-size:15px;">\n <button id="pw-btn" style="\n margin-top:14px;width:100%;padding:10px;border-radius:8px;\n background:#4f7cff;border:0;color:#fff;font-size:15px;cursor:pointer;">\n 确认\n </button>\n <p id="pw-msg" style="margin-top:10px;color:#ff7b7b;font-size:13px;display:none;">\n 密码错误，请重新输入\n </p>\n <p id="pw-lock" style="margin-top:10px;color:#ffd166;font-size:13px;display:none;">\n 密码输入错误次数过多，请 30 分钟后再尝试。\n </p>\n </div>\n</div>\n\n<script>\n(function(){\n // ======== 基础参数 ========\n const correct = "888"; // 密码明文\n const secret = btoa(correct + "##"); // 简易加密（防止明文出现）\n const PASS_KEY = "nav_access_pass"; // 本地存储字段\n const ERROR_KEY = "nav_access_err"; // 错误次数\n const LOCK_KEY = "nav_access_lock"; // 冻结计时\n\n const mask = document.getElementById("pw-mask");\n const input = document.getElementById("pw-input");\n const btn = document.getElementById("pw-btn");\n const msg = document.getElementById("pw-msg");\n const lockMsg = document.getElementById("pw-lock");\n\n // ======== 检查是否已通过验证 ========\n const saved = localStorage.getItem(PASS_KEY);\n const lockUntil = parseInt(localStorage.getItem(LOCK_KEY) || "0", 10);\n\n // 如果被冻结\n if(Date.now() < lockUntil){\n lockMsg.style.display = "block";\n input.disabled = true;\n btn.disabled = true;\n return;\n }\n\n // 已通过验证，直接隐藏遮罩\n if(saved === secret){\n mask.style.display = "none";\n return;\n }\n\n // ======== 密码检查函数 ========\n function check(){\n const val = input.value.trim();\n\n // 特殊：输错三次 -> 冻结 30 分钟\n let err = parseInt(localStorage.getItem(ERROR_KEY) || "0", 10);\n\n if(val === correct){\n // 写入通过标记（记住 24 小时）\n localStorage.setItem(PASS_KEY, secret);\n localStorage.removeItem(ERROR_KEY);\n localStorage.removeItem(LOCK_KEY);\n mask.style.display = "none";\n return;\n }\n\n // 输入错误\n err++;\n localStorage.setItem(ERROR_KEY, err.toString());\n msg.style.display = "block";\n input.value = "";\n input.focus();\n\n if(err >= 3){\n const lockTime = Date.now() + 30 * 60 * 1000; // 30 分钟\n localStorage.setItem(LOCK_KEY, lockTime.toString());\n input.disabled = true;\n btn.disabled = true;\n msg.style.display = "none";\n lockMsg.style.display = "block";\n }\n }\n\n // 点击确认\n btn.addEventListener("click", check);\n\n // 回车键确认\n input.addEventListener("keydown", function(e){\n if(e.key === "Enter") check();\n });\n\n input.focus();\n\n})();\n</script>\n<!-- 密码保护结束（增强版） -->\n <header class="site-header">\n <div class="container header-inner">\n <div class="brand">\n <span class="logo" aria-hidden="true">◼︎</span>\n <span class="brand-name">haoyifly 导航</span>\n </div>\n <nav class="top-nav">\n <a href="#links">入口</a>\n <a href="#ann">公告</a>\n <a href="#help">帮助</a>\n </nav>\n </div>\n </header>\n\n <noscript>\n <div class="banner">您的浏览器已禁用 JavaScript，实时延迟与跳转可能不准确。请启用 JS 或更换浏览器。</div>\n </noscript>\n\n <main>\n <section class="hero">\n <div class="container hero-inner">\n <h1>一站式入口 & 备用通道</h1>