 .catch(()=> null)\n .finally(()=> clearTimeout(tid));\n }\n async function testPing(host, id){\n const t = Date.now();\n const paths = [\'/__ok.txt\',\'/cdn-cgi/trace\',\'/health\'];\n for (const p of paths){\n const ms = await pingOnce(`https://${host}${p}?t=${t}`);\n if (ms !== null){ setPingText(id, ms); return; }\n }\n setPingText(id, null);\n }\n function loopPing(){ HOSTS.forEach(({host,id})=>testPing(host,id)); }\n loopPing(); setInterval(loopPing, 30000);\n </script>\n\n <script>\n (function(){\n var isFile = location.protocol === \'file:\';\n if(!isFile) return;\n try{\n [\'ping-t6\',\'ping-t2\',\'ping-t3\',\'ping-o1\',\'ping-o2\',\'ping-o3\'].forEach(function(id){\n var el=document.getElementById(id); if(el){ el.textContent=\'本地预览模式（未测速）\'; el.className=\'card-ping warn\'; }\n });\n var y=document.getElementById(\'y\'); if(y) y.textContent=new Date().getFullYear();\n var t=document.getElementById(\'ts\'); if(t) t.textContent=new Date().toISOString().slice(0,10);\n console.log(\'[preview] 以 file:// 打开，已切换为本地预览模式（不发起网络请求）\');\n }catch(e){console.warn(e)}\n })();\n </script>\n</body>\n</html>\n')

